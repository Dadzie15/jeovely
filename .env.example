# Jeovely environment configuration
# Copy to `.env` (git-ignored) and fill in values. Never commit real secrets.
# One file serves both apps: the API reads everything; the Vite frontend only
# ever exposes variables prefixed with VITE_ to the browser.

# ── Backend (server/) ─────────────────────────────────────────────
# development | test | production. In production, error responses never include stack traces.
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# Public base URL of the API (no /api suffix). Also used by the Vite dev proxy.
API_URL=http://localhost:4000

# Browser origin(s) allowed to call the API (CORS). Comma-separate multiple values.
FRONTEND_URL=http://localhost:5173

# Maximum JSON request body size accepted by the API.
JSON_BODY_LIMIT=100kb

# PostgreSQL connection string used by Prisma (server/prisma). Leave empty until
# you have a database; the API still starts and /api/health reports "not_configured".
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=

# Optional: database for `npm run test:api`. Its name MUST end in "_test" — the
# tests delete all rows. If unset, the runner uses DATABASE_URL's server with
# "_test" appended to the database name (e.g. flowly → flowly_test) and creates it.
TEST_DATABASE_URL=

# ── Authentication ────────────────────────────────────────────────
# Sessions are random tokens in an HttpOnly cookie, stored hashed in the
# database, so no signing secret is needed.
# How long a sign-in lasts, in days (1–90).
SESSION_TTL_DAYS=7

# Number of reverse proxies in front of the API in production (0 = none).
# Required for rate limiting to see real client IPs; leave 0 in development.
TRUST_PROXY=0

# ── Frontend (Vite) ───────────────────────────────────────────────
# Base URL the React app uses for API calls. Leave empty to use same-origin
# "/api" (proxied to API_URL by the Vite dev server). Set it when the API is on
# another origin, e.g. https://api.jeovely.example/api — and add the frontend's
# origin to FRONTEND_URL above.
VITE_API_URL=
